<% if(typeof showSearch !== "undefined" && showSearch){ %>

<form action="/listings/search" method="GET" class="search-bar">

    <div class="search-item">
        <label>Where</label>
        <input 
            type="text" 
            name="location"
            placeholder="Search destinations">
    </div>

    <div class="divider"></div>

    <div class="search-item">
        <label>What</label>
        <input 
            type="text"
            name="title"
            placeholder="Villa, Cabin, Beach House...">
    </div>

    <div class="divider"></div>

    <div class="search-item">
        <label>Upto</label>
        <input 
            type="number"
            name="price"
            placeholder="Add Budget">
    </div>

    <button type="submit" class="search-btn">
        <i class="fa-solid fa-magnifying-glass"></i>
    </button>

</form>

