<% layout("layouts/boilerplate") %>

<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
        <h3>Edit your listing</h3>
        <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation"> 

            <div class="mb-3">
                <lable for="title" class="form-lable">Title</lable>
                <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control" required />
                <div class="invalid-feedback">Enter a title</div>
            </div>
        
            <div class="mb-3">
                <lable for="description" class="form-lable">Description</lable>
                <textarea name="listing[description]" class="form-control" required><%= listing.description %></textarea>
                <div class="invalid-feedback"> description should be less than 150 words</div>
            </div>

            <div class="mb-3">
                <lable for="image" class="form-lable">Image Link</lable>
                <input 
                    name="listing[image][url]" 
                    value="<%= listing.image.url %>" 
                    class="form-control">
                <div class="invalid-feedback">Insert the Image</div>
            </div>

         <div class="row">   
            <div class="mb-3 col-md-4" >
                <lable for="price" class="form-lable"  >Price</lable>
                <input name="listing[price]" value="<%= listing.price %>"  class="form-control" required/>
                <div class="invalid-feedback">Price should be valid</div>
            </div>

            <div class="mb-3 col-md-8">
                <lable for="country" class="form-lable" >Country</lable>
                <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control" required />
                <div class="invalid-feedback">Country should be valid</div>
            </div>
        </div>
            
            <div class="mb-3">
                <lable for="location" class="form-lable">Location</lable>
                <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control" required/>
                <div class="invalid-feedback">Location should be valid</div>
            </div>
        
            <button class="btn btn-dark btn-save mt-3">Save</button>
        </form>
        </div>
    </div> 
    <script src="/js/script.js"></script>
</body>
