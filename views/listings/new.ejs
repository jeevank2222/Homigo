<% layout("/layouts/boilerplate")   %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
    <h3>New Listing</h3>  
    <form method="post" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
            <lable for="title" class="form-lable">Title</lable>
            <input name="listing[title]" placeholder="add title" type="text" class="form-control" required/>
            <div class="valid-feedback">
                Title looks good!
            </div>
        </div>
    
        <div class="mb-3">
            <lable for="description" class="form-lable">Description</lable>
            <textarea name="listing[description]" placeholder="add description" class="form-control"required ></textarea>
            <div class="invalid-feedback">
                description should be less than 150 words
            </div>
        </div>

        <div class="mb-3">
            <lable for="image" class="form-lable">Upload Listing Image</lable>
            <input name="listing[image][filename]" placeholder="add filename" type="file" class="form-control">
        </div>

        <div class="row">
        <div class="mb-3 col-md-4">
            <lable for="price" class="form-lable">Price</lable>
            <input name="listing[price]" placeholder="add price"  class="form-control" required />
             <div class="invalid-feedback">
                Price should be valid
            </div>
        </div>  

        <div class="mb-3 col-md-8">
            <lable for="country" class="form-lable">Country</lable>
            <input name="listing[country]" placeholder="add country" type="text" class="form-control" required />
            <div class="invalid-feedback">
                Country should be valid
            </div>
        </div>
        </div>
        
        <div class="mb-3">
            <lable for="location" class="form-lable">Location</lable>
            <input name="listing[location]" placeholder="add location" type="text" class="form-control" required />
            <div class="invalid-feedback">
                Location should be valid
            </div>
        </div>
        
    
        <button class="btn btn-dark add-btn mt-3">Add</button>
        <br/> <br>
    </form> 
    </div> 
    </div>
</body>
