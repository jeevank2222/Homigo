<% layout("/layouts/boilerplate")   %>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
    <h3>New Listing</h3>  
    <form method="post" action="/listings">
        <div class="mb-3">
            <lable for="title" class="form-lable">Title</lable>
            <input name="Listing[title]" placeholder="add title" type="text" class="form-control" />
        </div>
    
        <div class="mb-3">
            <lable for="description" class="form-lable">Description</lable>
            <textarea name="Listing[description]" placeholder="add description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <lable for="image" class="form-lable">Image Link</lable>
            <input name="Listing[image]" placeholder="add image url/link" class="form-control" />
        </div>

        <div class="row">
        <div class="mb-3 col-md-4">
            <lable for="price" class="form-lable">Price</lable>
            <input name="Listing[price]" placeholder="add price" type="number" class="form-control"/>
        </div>

        <div class="mb-3 col-md-8">
            <lable for="country" class="form-lable">Country</lable>
            <input name="Listing[country]" placeholder="add country" type="text" class="form-control" />
        </div>
        </div>
        
        <div class="mb-3">
            <lable for="location" class="form-lable">Location</lable>
            <input name="Listing[location]" placeholder="add location" type="text" class="form-control"/>
        </div>
        
    
        <button class="btn btn-dark add-btn mt-3">Add</button>
        <br/> <br>
    </form> 
    </div> 
    </div>
</body>
