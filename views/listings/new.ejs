<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homigo : New Listing</title>
</head>
<body>
    <h3>New Listing</h3>  
    <form method="post" action="/listings">
        <input name="Listing[title]" placeholder="add title" type="text" />
        <br/> <br>
        <textarea name="Listing[description]" placeholder="add description" ></textarea>
        <br/> <br>
        <input name="Listing[image]" placeholder="add image URL/Link" />
        <br/> <br>
        <input name="Listing[price]" placeholder="add price" type="number" />
        <br/> <br>
        <input name="Listing[location]" placeholder="add location" type="text"/>
        <br/> <br>
        <input name="Listing[country]" placeholder="add country" type="text" />
        <br/> <br>
        <button>Add</button>
    </form>  
</body>
</html>