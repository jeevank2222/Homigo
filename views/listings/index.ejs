<% layout("layouts/boilerplate") %>
<body>
    <div class="dark">
        <button id="theme-toggle" class="btn btn-outline-secondary">
         <i class="fa-solid fa-moon"></i>
        </button>
    </div>
    

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-2">
        <% for(let listing of allListings) {%>
            <a href="/listings/<%= listing._id  %>" class="listing-link">
            <div class="card col listing-card" >
             <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.image.filename %>" style="height: 20rem;" >
             <div class="card-img-overlay"></div>
                    <div class="card-body">
                    <p class="card-text"><b> <%= listing.title %> </b>
                     <br/> &#8377;<%= listing.price.toLocaleString("en-IN") %> 
                     </p>
                    </div>
             </div>
             </a>
          <% } %>
    </div>

</body>