<% layout("layouts/boilerplate") %>
<body>
    
    <% if(allListings.length === 0){ %>
    <div class="no-listings">
        <h3>No such listings found</h3>
        <p>Try searching with different keywords.</p>
    </div>
    <% } else { %>
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3 mt-1 mb-4">
        <% for(let listing of allListings) {%>
            <a href="/listings/<%= listing._id  %>" class="listing-link">
            <div class="card col listing-card" >
             <img src="<%= listing.image.url %>" class="card-img-top listing-img" alt="<%= listing.image.filename %>" style="height: 20rem;" >
             <div class="card-img-overlay"></div>
                    <div class="card-body">
                    <p class="card-text"><b> <%= listing.title %> </b>
                     <br/><b> &#8377; <%= listing.price.toLocaleString("en-IN") %> </b>
                    <% if (listing.category === "experience") { %>/ guest
                    <% } else if (listing.category === "home") { %> / night
                    <% } %> <br/>
                    <i class="fa-solid fa-location-dot"></i><%= listing.location %> 
                     </p>
                    </div>
             </div>
             </a>
          <% } %>        
    </div>
      <% } %>


</body>